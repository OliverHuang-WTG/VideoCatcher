<Window x:Class="VideoCatcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VideoCatcher" Width="1400" Height="860" MinWidth="640" MinHeight="400"
        Icon="Assets/VideoCatcher.ico" StateChanged="Window_StateChanged">
    <!-- Tabs live in the title bar like Edge, so the window draws its own caption.
         A non-zero glass frame keeps the DWM frame: with GlassFrameThickness="0" WindowChrome clips the window
         to a rectangular region, which rules out Windows 11's rounded corners and shadow. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="IconButton" TargetType="ButtonBase">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- On: filled with the accent color. Off: muted text. The label also changes, so the state never
             depends on color alone. -->
        <Style x:Key="ProxyButton" TargetType="ToggleButton" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="10" />
        </Style>

        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="MinWidth" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>

        <!-- Plain text box for the pill-shaped address bar; the themed one draws its own border and underline. -->
        <Style x:Key="BareTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabItem" TargetType="ListBoxItem">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <EventSetter Event="PreviewMouseDown" Handler="Tab_PreviewMouseDown" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Height="34" Margin="0,6,2,0" Padding="10,0,4,0" CornerRadius="8,8,0,0"
                                Background="Transparent">
                            <DockPanel>
                                <Button x:Name="Close" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                        Width="24" Height="24" FontSize="10" Content="&#xE8BB;" Visibility="Hidden"
                                        ToolTip="关闭标签 (Ctrl+W)" Click="CloseTab_Click" />
                                <Grid Width="16" Height="16" Margin="0,0,8,0">
                                    <TextBlock x:Name="Globe" Text="&#xE774;" FontFamily="{StaticResource IconFont}"
                                               FontSize="14" Visibility="Collapsed"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Source="{Binding Favicon}" />
                                </Grid>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Favicon}" Value="{x:Null}">
                                <Setter TargetName="Globe" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Close" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}" />
                                <Setter TargetName="Close" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,4" />
        </Style>

        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="ItemIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Height="40" SizeChanged="TitleBar_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                <Image Source="Assets/VideoCatcher.ico" Width="16" Height="16" Margin="0,6,10,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <!-- Width is set by LayoutTabs so tabs keep a fixed width and shrink evenly once crowded. -->
                <ListBox x:Name="TabStrip" Background="Transparent" BorderThickness="0" Padding="0"
                         ItemContainerStyle="{StaticResource TabItem}" SelectionChanged="TabStrip_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         WindowChrome.IsHitTestVisibleInChrome="True">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
                <Button Style="{StaticResource IconButton}" Content="&#xE710;" Margin="4,6,0,0"
                        ToolTip="新标签 (Ctrl+T)" Click="NewTab_Click" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" />
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                        Click="Maximize_Click" />
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click" />
            </StackPanel>
        </Grid>

        <Border x:Name="Toolbar" Grid.Row="1" Height="44" BorderThickness="0,0,0,1"
                Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <DockPanel Margin="6,0">
                <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="后退"
                        Click="Back_Click" />
                <Button x:Name="ForwardButton" Style="{StaticResource IconButton}" Content="&#xE72A;" ToolTip="前进"
                        Click="Forward_Click" />
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="刷新 (F5)" Click="Reload_Click" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ToggleButton x:Name="ProxyButton" Style="{StaticResource ProxyButton}" Click="Proxy_Click">
                        <StackPanel Orientation="Horizontal" Margin="10,0">
                            <TextBlock Text="&#xEA18;" VerticalAlignment="Center" />
                            <TextBlock x:Name="ProxyLabel" FontFamily="Segoe UI" FontSize="12" Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="设置" Click="Settings_Click" />
                </StackPanel>

                <Border Height="32" Margin="8,0" Padding="12,0" CornerRadius="16"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                    <DockPanel>
                        <TextBlock x:Name="AddressIcon" Text="&#xE774;" FontFamily="{StaticResource IconFont}"
                                   FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBox x:Name="Address" Style="{StaticResource BareTextBox}" KeyDown="Address_KeyDown"
                                 PreviewMouseLeftButtonDown="Address_PreviewMouseLeftButtonDown" />
                    </DockPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- The sidebar is a column beside the WebView2s rather than an overlay: WebView2 is a native window
             that would cover any WPF element drawn over it. -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="SidebarColumn" Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Each tab's WebView2 stays in here and only toggles visibility, so it's never re-parented. -->
            <Grid x:Name="Views" />

            <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" Background="Transparent"
                          DragCompleted="SidebarSplitter_DragCompleted" />

            <Border x:Name="Sidebar" Grid.Column="2" BorderThickness="1,0,0,0"
                    Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                <Grid>
                    <Grid x:Name="SidebarPanel" Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="120" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="120" />
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE76C;"
                                        FontSize="12" ToolTip="收起侧边栏" Click="ToggleSidebar_Click" />
                                <TextBlock x:Name="VideoHeader" Text="当前页视频" Style="{StaticResource SectionTitle}" />
                            </DockPanel>
                            <TextBlock x:Name="VideoEmpty" DockPanel.Dock="Top" Text="播放视频后会出现在这里"
                                       Style="{StaticResource SecondaryText}" Margin="8,4,8,8" />
                            <ListBox x:Name="VideoList" Background="Transparent" BorderThickness="0"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4" ToolTip="{Binding Url}">
                                            <Button DockPanel.Dock="Right" Content="下载" Padding="12,4"
                                                    VerticalAlignment="Center" Click="Download_Click" />
                                            <TextBlock DockPanel.Dock="Left" Text="&#xE714;" Style="{StaticResource ItemIcon}" />
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource SecondaryText}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- The splitter is transparent and taller than the line so it's easy to grab. -->
                        <Rectangle Grid.Row="1" Height="1" Margin="0,4" VerticalAlignment="Center"
                                   Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
                        <GridSplitter Grid.Row="1" Height="9" HorizontalAlignment="Stretch"
                                      ResizeBehavior="PreviousAndNext" Background="Transparent" />

                        <DockPanel Grid.Row="2">
                            <DockPanel DockPanel.Dock="Top">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE838;"
                                        ToolTip="打开下载文件夹" Click="OpenFolder_Click" />
                                <TextBlock Text="下载" Style="{StaticResource SectionTitle}" />
                            </DockPanel>
                            <TextBlock x:Name="DownloadEmpty" DockPanel.Dock="Top" Text="暂无下载"
                                       Style="{StaticResource SecondaryText}" Margin="8,4,8,8" />
                            <ListBox x:Name="DownloadList" Background="Transparent" BorderThickness="0"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     MouseDoubleClick="DownloadList_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4" Background="Transparent">
                                            <DockPanel.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="打开" IsEnabled="{Binding IsCompleted}"
                                                              Click="OpenDownload_Click" />
                                                    <MenuItem Header="在文件夹中显示" IsEnabled="{Binding IsCompleted}"
                                                              Click="ShowInFolder_Click" />
                                                    <Separator />
                                                    <MenuItem Header="从列表移除" IsEnabled="{Binding IsIdle}"
                                                              Click="RemoveDownload_Click" />
                                                </ContextMenu>
                                            </DockPanel.ContextMenu>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                                    Width="28" Height="28" FontSize="12" Content="&#xE711;" ToolTip="取消"
                                                    VerticalAlignment="Center" Click="Cancel_Click"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock DockPanel.Dock="Left" Text="&#xE8A5;" Style="{StaticResource ItemIcon}" />
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Margin="0,4"
                                                             Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="{Binding Status}" ToolTip="{Binding Status}"
                                                           Style="{StaticResource SecondaryText}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Grid>

                    <!-- The badge is the only hint of captured videos while the sidebar is collapsed. -->
                    <Button x:Name="SidebarRail" Style="{StaticResource IconButton}" VerticalAlignment="Top"
                            Margin="2,8" ToolTip="展开侧边栏" Click="ToggleSidebar_Click">
                        <Grid Width="32" Height="28">
                            <TextBlock Text="&#xE714;" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border x:Name="RailBadge" Style="{StaticResource Badge}">
                                <TextBlock x:Name="RailBadgeText" Style="{StaticResource BadgeText}" />
                            </Border>
                        </Grid>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
