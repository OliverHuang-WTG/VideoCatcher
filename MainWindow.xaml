<Window x:Class="VideoCatcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VideoCatcher" Width="1400" Height="860">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel x:Name="Toolbar" Margin="4">
            <Button x:Name="BackButton" Content="←" Width="32" Click="Back_Click" />
            <Button x:Name="ForwardButton" Content="→" Width="32" Margin="2,0,0,0" Click="Forward_Click" />
            <Button Content="⟳" Width="32" Margin="2,0,0,0" Click="Reload_Click" ToolTip="刷新 (F5)" />
            <Button Content="+" Width="32" Margin="2,0,0,0" Click="NewTab_Click" ToolTip="新标签 (Ctrl+T)" />
            <Button DockPanel.Dock="Right" Content="设置" Padding="10,0" Margin="4,0,0,0" Click="Settings_Click" />
            <TextBox x:Name="Address" Margin="4,0,0,0" VerticalContentAlignment="Center" KeyDown="Address_KeyDown" />
        </DockPanel>

        <!-- Headers only: WebView2s live in Views so they are never re-parented when switching tabs. -->
        <TabControl x:Name="Tabs" Grid.Row="1" BorderThickness="0" Padding="0" SelectionChanged="Tabs_SelectionChanged" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="SideColumn" Width="420" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="Views" />

            <GridSplitter x:Name="Splitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="当前页视频" FontWeight="Bold" Margin="6,4" />
                <ListView x:Name="MediaList" Grid.Row="1">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="ToolTip" Value="{Binding Url}" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="标题" Width="180" DisplayMemberBinding="{Binding Title}" />
                            <GridViewColumn Header="类型" Width="60" DisplayMemberBinding="{Binding TypeText}" />
                            <GridViewColumn Header="大小" Width="80" DisplayMemberBinding="{Binding SizeText}" />
                            <GridViewColumn Width="60">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="下载" Padding="8,0" Click="Download_Click" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <TextBlock Grid.Row="2" Text="下载" FontWeight="Bold" Margin="6,4" />
                <ListView x:Name="DownloadList" Grid.Row="3">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="ToolTip" Value="{Binding Status}" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="文件名" Width="170" DisplayMemberBinding="{Binding FileName}" />
                            <GridViewColumn Header="进度" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ProgressBar Width="66" Height="12" Value="{Binding Progress, Mode=OneWay}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="状态" Width="100" DisplayMemberBinding="{Binding Status}" />
                            <GridViewColumn Width="50">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="取消" Padding="6,0" Click="Cancel_Click" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Window>
