<Window x:Class="VideoCatcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VideoCatcher" Width="1400" Height="860" MinWidth="640" MinHeight="400"
        StateChanged="Window_StateChanged">
    <!-- Tabs live in the title bar like Edge, so the window draws its own caption. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="IconButton" TargetType="ButtonBase">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Ignores clicks while its flyout is open: the click that closes a StaysOpen=False popup would
             otherwise reopen it straight away. -->
        <Style x:Key="FlyoutButton" TargetType="ToggleButton" BasedOn="{StaticResource IconButton}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="IsHitTestVisible" Value="False" />
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProxyButton" TargetType="ToggleButton" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="68" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="10" />
        </Style>

        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="MinWidth" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>

        <!-- Plain text box for the pill-shaped address bar; the themed one draws its own border and underline. -->
        <Style x:Key="BareTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabItem" TargetType="ListBoxItem">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <EventSetter Event="PreviewMouseDown" Handler="Tab_PreviewMouseDown" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Height="34" Margin="0,6,2,0" Padding="10,0,4,0" CornerRadius="8,8,0,0"
                                Background="Transparent">
                            <DockPanel>
                                <Button x:Name="Close" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                        Width="24" Height="24" FontSize="10" Content="&#xE8BB;" Visibility="Hidden"
                                        ToolTip="关闭标签 (Ctrl+W)" Click="CloseTab_Click" />
                                <Grid Width="16" Height="16" Margin="0,0,8,0">
                                    <TextBlock x:Name="Globe" Text="&#xE774;" FontFamily="{StaticResource IconFont}"
                                               FontSize="14" Visibility="Collapsed"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Source="{Binding Favicon}" />
                                </Grid>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Favicon}" Value="{x:Null}">
                                <Setter TargetName="Globe" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Close" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}" />
                                <Setter TargetName="Close" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shadow sits on its own layer so the effect doesn't blur the flyout's text. -->
        <Style x:Key="FlyoutShadow" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Flyout" TargetType="Border">
            <Setter Property="Width" Value="380" />
            <Setter Property="MaxHeight" Value="480" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceStrokeColorFlyoutBrush}" />
        </Style>

        <Style x:Key="FlyoutTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,4" />
        </Style>

        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="ItemIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Height="40" SizeChanged="TitleBar_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                <!-- Width is set by LayoutTabs so tabs keep a fixed width and shrink evenly once crowded. -->
                <ListBox x:Name="TabStrip" Background="Transparent" BorderThickness="0" Padding="0"
                         ItemContainerStyle="{StaticResource TabItem}" SelectionChanged="TabStrip_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         WindowChrome.IsHitTestVisibleInChrome="True">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
                <Button Style="{StaticResource IconButton}" Content="&#xE710;" Margin="4,6,0,0"
                        ToolTip="新标签 (Ctrl+T)" Click="NewTab_Click" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" />
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                        Click="Maximize_Click" />
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click" />
            </StackPanel>
        </Grid>

        <Border x:Name="Toolbar" Grid.Row="1" Height="44" BorderThickness="0,0,0,1"
                Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <DockPanel Margin="6,0">
                <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="后退"
                        Click="Back_Click" />
                <Button x:Name="ForwardButton" Style="{StaticResource IconButton}" Content="&#xE72A;" ToolTip="前进"
                        Click="Forward_Click" />
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="刷新 (F5)" Click="Reload_Click" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ToggleButton x:Name="ProxyButton" Style="{StaticResource ProxyButton}" Click="Proxy_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA18;" VerticalAlignment="Center" />
                            <TextBlock Text="代理" FontFamily="Segoe UI" FontSize="12" Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="VideoButton" Style="{StaticResource FlyoutButton}" ToolTip="当前页视频"
                                  IsChecked="{Binding IsOpen, ElementName=VideoPopup, Mode=TwoWay}">
                        <Grid Width="32" Height="28">
                            <TextBlock Text="&#xE714;" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border x:Name="VideoBadge" Style="{StaticResource Badge}">
                                <TextBlock x:Name="VideoBadgeText" Style="{StaticResource BadgeText}" />
                            </Border>
                        </Grid>
                    </ToggleButton>
                    <ToggleButton x:Name="DownloadButton" Style="{StaticResource FlyoutButton}" ToolTip="下载"
                                  IsChecked="{Binding IsOpen, ElementName=DownloadPopup, Mode=TwoWay}">
                        <Grid Width="32" Height="28">
                            <TextBlock Text="&#xE896;" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border x:Name="DownloadBadge" Style="{StaticResource Badge}">
                                <TextBlock x:Name="DownloadBadgeText" Style="{StaticResource BadgeText}" />
                            </Border>
                        </Grid>
                    </ToggleButton>
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="设置" Click="Settings_Click" />
                </StackPanel>

                <Border Height="32" Margin="8,0" Padding="12,0" CornerRadius="16"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                    <DockPanel>
                        <TextBlock x:Name="AddressIcon" Text="&#xE774;" FontFamily="{StaticResource IconFont}"
                                   FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBox x:Name="Address" Style="{StaticResource BareTextBox}" KeyDown="Address_KeyDown"
                                 PreviewMouseLeftButtonDown="Address_PreviewMouseLeftButtonDown" />
                    </DockPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Each tab's WebView2 stays in here and only toggles visibility, so it's never re-parented. -->
        <Grid x:Name="Views" Grid.Row="2" />

        <!-- Flyouts are Popups because WebView2 is a native window that covers any WPF element over it.
             HorizontalOffset right-aligns the 404px popup (380 + 2 x 12 shadow margin) with its 36px button. -->
        <Popup x:Name="VideoPopup" PlacementTarget="{Binding ElementName=VideoButton}" Placement="Bottom"
               HorizontalOffset="-356" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Grid Margin="12">
                <Border Style="{StaticResource FlyoutShadow}" />
                <Border Style="{StaticResource Flyout}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="当前页视频" Style="{StaticResource FlyoutTitle}" />
                        <TextBlock x:Name="VideoEmpty" DockPanel.Dock="Top" Text="播放视频后会出现在这里"
                                   Style="{StaticResource SecondaryText}" Margin="8,4,8,8" />
                        <ListBox x:Name="VideoList" Background="Transparent" BorderThickness="0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,4" ToolTip="{Binding Url}">
                                        <Button DockPanel.Dock="Right" Content="下载" Padding="12,4"
                                                VerticalAlignment="Center" Click="Download_Click" />
                                        <TextBlock DockPanel.Dock="Left" Text="&#xE714;" Style="{StaticResource ItemIcon}" />
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource SecondaryText}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Popup>

        <Popup x:Name="DownloadPopup" PlacementTarget="{Binding ElementName=DownloadButton}" Placement="Bottom"
               HorizontalOffset="-356" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Grid Margin="12">
                <Border Style="{StaticResource FlyoutShadow}" />
                <Border Style="{StaticResource Flyout}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE838;"
                                    ToolTip="打开下载文件夹" Click="OpenFolder_Click" />
                            <TextBlock Text="下载" Style="{StaticResource FlyoutTitle}" />
                        </DockPanel>
                        <TextBlock x:Name="DownloadEmpty" DockPanel.Dock="Top" Text="暂无下载"
                                   Style="{StaticResource SecondaryText}" Margin="8,4,8,8" />
                        <ListBox x:Name="DownloadList" Background="Transparent" BorderThickness="0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MouseDoubleClick="DownloadList_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,4">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                                Width="28" Height="28" FontSize="12" Content="&#xE711;" ToolTip="取消"
                                                VerticalAlignment="Center" Click="Cancel_Click"
                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock DockPanel.Dock="Left" Text="&#xE8A5;" Style="{StaticResource ItemIcon}" />
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                            <ProgressBar Value="{Binding Progress, Mode=OneWay}" Margin="0,4"
                                                         Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="{Binding Status}" ToolTip="{Binding Status}"
                                                       Style="{StaticResource SecondaryText}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Popup>
    </Grid>
</Window>
